# Copy this file to .env.local (and/or .env for DATABASE_URL) and fill in real values.

# --- Database (Postgres via Prisma's @prisma/adapter-pg) ---
# Must be a plain `postgres://` connection string — NOT the `prisma+postgres://`
# proxy URL that `prisma dev` prints by default, which this project's driver
# adapter can't talk to. For local dev: `npx prisma dev start default`, then
# use its printed "postgres://postgres:postgres@localhost:<port>/template1..." URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# --- Sanity CMS (product catalog, testpoint diagrams, banners) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# --- Flutterwave (checkout payment gateway) ---
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
# Set this to the same "Secret Hash" you configure in the Flutterwave dashboard
# for the webhook pointed at /api/checkout/webhook.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — server-only, bypasses Row Level Security. Used by
# src/lib/supabaseAdmin.ts for the /admin product image uploader. NEVER
# prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- MobileAPI.dev (phone spec lookups) ---
# From https://mobileapi.dev/signup/ — used by `npm run import:phones` (bulk
# import script) AND by the admin "Auto-Fill from Web" button on the Phone
# product form (src/lib/mobileApi.ts, /api/admin/phone-lookup/*). Free tier:
# 200 requests/month, 5/min.
MOBILEAPI_DEV_KEY=""

# --- Email (order confirmation / payment confirmation notifications) ---
# From https://resend.com — free tier covers a small shop's volume easily.
# Both must be set for emails to actually send; if either is missing, emails
# are silently skipped (logged, not thrown) rather than failing checkout.
RESEND_API_KEY=""
# Must be a verified sender/domain in your Resend account, e.g.
# "Phone Hub <orders@yourdomain.com>" — Resend's shared test domain only
# delivers to your own account email, not real customers.
EMAIL_FROM=""

# --- Admin tools (/admin/**) ---
# Shared password gating the whole internal admin panel. This is a
# lightweight single-secret gate, not real per-user auth — see
# src/lib/adminAuth.ts for the tradeoffs. Sessions themselves are real
# (DB-backed, revocable, expiring) even though the password is shared.
ADMIN_PASSWORD=""

# --- Error monitoring (optional) ---
# From https://sentry.io — leave both blank to leave Sentry fully inactive
# (its SDK no-ops with no DSN, see instrumentation.ts / instrumentation-client.ts).
# SENTRY_DSN covers server + edge; NEXT_PUBLIC_SENTRY_DSN is the browser-side
# one (usually the same DSN value, just re-exposed under the public prefix).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- App ---
# Used to build absolute URLs (Flutterwave redirect_url, sitemap, OG tags).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
