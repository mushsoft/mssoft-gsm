generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  PHONE
  ACCESSORY
  SPARE_PART
  REPAIR_TOOL
  KIDS_TAB
  LAPTOP
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum RepairRequestStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Product {
  id            String       @id @default(uuid())
  title         String
  slug          String       @unique
  description   String
  price         Int          // Whole UGX — the currency has no widely-used subunit
  originalPrice Int?         // Set to show a strikethrough "was" price on Hot Deals
  isHotDeal     Boolean      @default(false)
  stock         Int          @default(0)
  category      CategoryType
  subcategory   String?      // e.g. SCREEN, BATTERY, CHARGER — see src/lib/productSpecFields.ts
  brand         String       // e.g. Samsung, Tecno, Apple
  modelName     String?      // e.g. Galaxy A12, iPhone 11
  images        String[]
  specs         Json?        // Dynamic specs (RAM, Storage, Condition)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  OrderItem    OrderItem[]
  Review       Review[]
  WishlistItem WishlistItem[]
  PageView     PageView[]

  @@index([createdAt])
}

model TestPoint {
  id         String   @id @default(uuid())
  brand      String   // e.g. Tecno, Infinix, Samsung
  modelName  String   // e.g. Spark 8 Pro
  chipset    String   // e.g. MediaTek MT6769, Snapdragon 680
  pointType  String   // EDL, BROM, ISP, SCHEMATIC — see src/lib/testPointTypes.ts
  title      String   // e.g. EMMC / UFS ISP Pinout
  diagramUrl String   // Image link
  notes      String?  // Voltages, CLK, CMD instructions
  createdAt  DateTime @default(now())
}

// A reseller line item for a phone-unlocking/flashing/FRP/schematic tool
// credit or activation (DC-Unlocker, Octoplus, NCK, Miracle, UnlockTool,
// etc.) — displayed on /shop/unlock-tools grouped by `category`. creditCost
// is the raw supplier cost in that reseller's own "Credit" unit; the UGX
// price shown to customers is computed at render time from creditCost ×
// ShopProfile.creditRateUgx × a markup (see src/lib/softwareToolPricing.ts),
// never stored, so one rate update instantly re-prices every listing.
model SoftwareTool {
  id         String   @id @default(uuid())
  category   String   // e.g. "DC-Unlocker & HCU", "Octoplus / Octopus Box" — grouping heading
  title      String   // e.g. "DC-Unlocker And HCU Credits For Existing User"
  creditCost Float    // supplier cost in Credit units, e.g. 0.668, 60.62
  order      Int      @default(0) // manual sort position within its category
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  toolOrders ToolOrder[]

  @@index([category])
}

enum GuideCategory {
  REPAIR // hardware repair guide, listed on /learn-to-repair
  SOFTWARE // software tip (flashing, FRP, unlocking…), listed on /learn-to-repair/software-tips
}

model RepairGuide {
  id        String   @id @default(uuid())
  category  GuideCategory @default(REPAIR)
  title     String   // e.g. Tecno Camon 18 Charging Flex Fix
  brand     String   // may be '' for a general software tip
  modelName String   // may be '' for a general software tip
  videoUrl  String?  // YouTube embed link
  thumbnail String
  content   String   // Written step-by-step
  toolsUsed String[]
  createdAt DateTime @default(now())
}

model Order {
  id                String            @id @default(uuid())
  customerName      String
  customerPhone     String            // e.g. +256...
  customerEmail     String
  totalAmount       Int               // Whole UGX — the currency has no widely-used subunit
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PROCESSING)
  txRef             String            @unique
  paymentMethod     String            // "MOBILE_MONEY", "CARD", or "AIRTEL_MONEY"
  // Customer-supplied Airtel Money transaction code (AIRTEL_MONEY orders
  // only) — there's no payment-gateway webhook for a direct-to-merchant-ID
  // payment, so this is what an admin cross-checks against their Airtel
  // Money SMS/app before manually marking the order paid.
  paymentReference  String?
  items             OrderItem[]
  createdAt         DateTime          @default(now())

  customerId     String?  // nullable — guest checkout keeps working
  couponCode     String?
  discountAmount Int?     @default(0)

  customer Customer? @relation(fields: [customerId], references: [id])
  coupon   Coupon?   @relation(fields: [couponCode], references: [code])

  @@index([customerId])
  @@index([couponCode])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// Mirrors the Supabase Auth user for this app's own DB (a separate Postgres
// instance from Supabase's project) — created lazily on first login via
// getOrCreateCustomer() in src/lib/customerAuth.ts. Supabase owns credentials
// and sessions; this row is the join point for all app-side relations.
model Customer {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique
  email          String   @unique
  name           String?
  // Display handle, not a login identifier (login is by email) — but still
  // unique. Nullable rather than required so pre-existing rows created before
  // this field existed stay valid; Postgres treats multiple NULLs as
  // non-conflicting under a unique index. Enforced at signup time by
  // creating the Customer row eagerly in /api/account/signup rather than
  // waiting for getOrCreateCustomer's lazy first-login upsert — otherwise
  // two unconfirmed signups could pick the same value before either ever hit
  // the constraint.
  username       String?  @unique
  phone          String?  @unique
  referralSource String? // Free-text answer to "How did you hear about us?"
  // Prepaid balance for unlock-tool purchases, in USD cents. Only ever
  // changed inside the same DB transaction that writes the matching
  // WalletTransaction row (see src/lib/wallet.ts), so it always equals the
  // sum of the customer's COMPLETED transactions — the ledger is the record,
  // this is a cached total that can be checked/debited atomically.
  walletBalanceCents Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders             Order[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  repairRequests     RepairRequest[]
  walletTransactions WalletTransaction[]
  toolOrders         ToolOrder[]
  notifications      Notification[]
}

// A message in the customer's account inbox (My Account → Messages), sent
// alongside the matching email whenever something happens to their order,
// top-up or tool order — see src/lib/notifications.ts.
model Notification {
  id         String    @id @default(uuid())
  customerId String
  title      String
  body       String
  link       String? // where "View" goes, e.g. /account/orders
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}

enum WalletTransactionType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// One line of a customer's wallet history. A TOPUP starts PENDING when the
// customer starts paying and only becomes COMPLETED (crediting the balance)
// after the payment gateway's own API confirms it — or an admin approves a
// manual Airtel Money top-up. Never deleted; failed top-ups stay as FAILED.
model WalletTransaction {
  id               String                  @id @default(uuid())
  customerId       String
  type             WalletTransactionType
  status           WalletTransactionStatus @default(PENDING)
  // USD cents. Positive adds to the balance (top-up, refund), negative
  // spends it (purchase).
  amountCents      Int
  // Top-ups: the UGX the customer pays, and the UGX-per-USD rate locked in
  // when they started, so a later rate change can't alter this top-up.
  amountUgx        Int?
  usdRate          Float?
  paymentMethod    String? // PAWAPAY, MOBILE_MONEY, CARD or AIRTEL_MONEY
  txRef            String                  @unique // our reference: "WT-" top-up, "WP-" purchase, "WR-" refund
  // pawaPay depositId, or the Airtel Money transaction ID the customer typed.
  paymentReference String?
  note             String?
  // PURCHASE / REFUND rows point at the tool order they paid for / refunded.
  toolOrderId      String?
  createdAt        DateTime                @default(now())
  completedAt      DateTime?

  customer  Customer   @relation(fields: [customerId], references: [id])
  toolOrder ToolOrder? @relation(fields: [toolOrderId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, paymentMethod])
  @@index([paymentReference])
  @@index([toolOrderId])
}

enum ToolOrderStatus {
  PAID // paid from the wallet, waiting for the admin to load it
  COMPLETED // admin loaded the credits/activation on the supplier panel
  REFUNDED // couldn't be fulfilled; the amount went back to the wallet
}

// An unlock/flash tool bought with wallet balance. Tool name and prices are
// copied in at purchase time so later edits/deletes of the SoftwareTool
// listing (or rate changes) never alter what the customer paid for.
model ToolOrder {
  id             String          @id @default(uuid())
  customerId     String
  softwareToolId String?
  toolTitle      String
  toolCategory   String
  perCredit      Boolean
  quantity       Int             @default(1) // credits for per-credit products, else 1
  unitPriceCents Int
  totalCents     Int
  // What the customer entered for this tool's order form, in form order:
  // [{ "label": "Hydra email", "value": "tech@example.com" }, ...]
  details        Json
  notes          String?
  status         ToolOrderStatus @default(PAID)
  // Shown to the customer — e.g. an activation code, or why it was refunded.
  adminNote      String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  refundedAt     DateTime?

  customer           Customer            @relation(fields: [customerId], references: [id])
  softwareTool       SoftwareTool?       @relation(fields: [softwareToolId], references: [id], onDelete: SetNull)
  walletTransactions WalletTransaction[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

// A private "ask a technician" request — separate from RepairGuide, which is
// public how-to content. Requires a logged-in customer (see requireCustomerPage
// in /account/repair-requests) rather than supporting guests like Order does,
// since there's no guest-tracking page for this and the reply is only ever
// shown in-account.
model RepairRequest {
  id         String              @id @default(uuid())
  customerId String
  brand      String?
  modelName  String?
  problem    String
  imageUrl   String?
  status     RepairRequestStatus @default(OPEN)
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  customerId String
  rating     Int      // 1-5, validated in application code
  title      String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique // matched uppercase in application code
  discountType DiscountType
  value        Int          // percent (0-100) or fixed whole-UGX amount, per discountType
  active       Boolean      @default(true)
  expiresAt    DateTime?
  maxUses      Int?
  usedCount    Int          @default(0)
  createdAt    DateTime     @default(now())

  orders Order[]
}

// One row per page visit, fired client-side by src/components/VisitTracker.tsx
// on every route change. productId is populated when the path is a product
// detail page, so "most viewed products" is just a groupBy on this table
// instead of needing a separate view-counter column on Product.
model PageView {
  id        String   @id @default(uuid())
  path      String
  productId String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([productId])
}

// Admin auth moved to Supabase Auth (named accounts, app_metadata.role,
// TOTP MFA) — this table is no longer written to or read by the app. Left
// in place rather than dropped: the migration to drop it needs someone to
// run it directly (a schema-only DROP TABLE was blocked by this session's
// permission classifier as a "mass delete" risk). Safe to drop by hand
// whenever convenient — it holds no data of value, only expired session ids.
model AdminSession {
  id        String    @id @default(uuid())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Singleton (one row) — the shop's own details stamped on generated
// documents (invoices, receipts, delivery notes, quotations) and edited via
// /admin/settings. Not used for storefront display (Footer.tsx/layout.tsx
// still own that) to keep this change scoped to the new documents feature.
model ShopProfile {
  id           String   @id @default(uuid())
  businessName String   @default("MS Soft GSM")
  tagline      String? // e.g. "Phones, Spares, Repairs And Accessories" — shown as a smaller subheading under businessName on invoices/receipts, kept separate so the heading itself stays short
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  tiktok       String?
  instagram    String?
  facebook     String?
  address      String?
  tinNumber    String? // Uganda Tax Identification Number — optional, shown on invoices if set
  // Backup UGX-per-USD rate for unlock-tool prices, used only when the live
  // market rate can't be fetched (see src/lib/usdRate.ts). Column name kept
  // from when it was the "UGX per supplier Credit" rate.
  creditRateUgx Int      @default(4300)
  // UGX added on top of the USD→UGX market rate for unlock-tool prices,
  // e.g. market 4,131 + 99 → we price at 4,230 per $1.
  usdRateAddonUgx Int    @default(99)
  updatedAt    DateTime @updatedAt
}

// A saved snapshot of a generated document (invoice/sales receipt/delivery
// note/quotation) — created when an admin hits "Save" on /admin/receipts/new,
// /admin/receipts/[id], or /admin/orders/[id]/receipt. Deliberately a
// point-in-time copy, not a live view: editing it later never touches the
// linked Order (if any), and a change to that Order never touches this row.
// No formal Prisma relation to Order — orderId is just a soft reference so a
// receipt can outlive a deleted order without a cascade/constraint to manage.
model Receipt {
  id               String   @id @default(uuid())
  docType          String // INVOICE | RECEIPT | DELIVERY_NOTE | QUOTATION — the tab selected at last save
  reference        String // frozen at first save (the order's txRef, or a generated walk-in ref) — the document number is derived from this and must not change on later edits
  orderId          String? // set when generated from a real order; null for a walk-in/ad-hoc receipt
  documentDate     DateTime
  customerName     String
  customerPhone    String
  customerEmail    String
  deliveryAddress  String?
  items            Json // [{ title, quantity, price }]
  discountAmount   Int      @default(0)
  paymentStatus    String // PENDING | SUCCESSFUL — a snapshot, independent of the linked order's current status
  paymentMethod    String
  paymentReference String?
  notes            Json? // { [docType]: string } — per-type notes, so switching tabs keeps each type's text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([createdAt])
}